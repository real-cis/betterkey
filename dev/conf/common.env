# Identifier for this cluster. Remote attestations verify the cluster id.
CLUSTER_ID=mycluster
# FQDN for the key server, used in ACME certificate fetch
SERVER_DOMAIN=betterkey.example.com
# Valkey/Redis configuration
VALKEY_URIS=valkey:6379
VALKEY_USER=default
VALKEY_PASSWORD=valkeypass
VALKEY_NAMESPACE=DEV
VALKEY_TLS=false
# Encryption key for Memberlist cluster
CLUSTER_ENCRYPTIONKEY=secret
# With DEV_MODE=1, services mock tdx attestation verification, keystore uses dev namespace
DEV_MODE=1

## ACME Configuration, if none provided, default node TLS will be used for the key service 
# ACME_OWNER=acmeowner@example.com
# ACME_DNS_API_TOKEN=
# ACME_RETRY_DELAY=10
# ACME_RETRY_COUNT=5
# ACME_PROVIDER=
